# --- 배포자 ---
PRIVATE_KEY=0x...
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=            # 선택. verify 할 때만

# --- Chainlink VRF v2.5 (Ethereum Sepolia) ---
# 배포 전에 https://docs.chain.link/vrf/v2-5/supported-networks 에서 한 번 더 확인하세요.
VRF_COORDINATOR=0x9DdfaCa8183c41ad55329BdeeD9F6A8d53168B1B
VRF_KEY_HASH=0x787d74caea10b2b357790d5b5247c2f63d1d91572a9846f780606e4d953677ae
VRF_SUBSCRIPTION_ID=          # https://vrf.chain.link 에서 만든 구독 ID (긴 숫자)
VRF_ADD_CONSUMER=true         # 배포자가 구독 owner 면 스크립트가 consumer 등록까지 수행

# --- 로또 설정 ---
EPOCH_DURATION=600            # 초. 데모용 10분
LIQUIDITY_ETH=20000000000000000   # 0.02 ETH 를 풀 유동성으로 (토큰도 같은 수량)
PRIZE_ETH=10000000000000000       # 0.01 ETH 를 첫 상금으로 예치
